{
  "name": "@rhai/api",
  "version": "0.1.0",
  "private": true,
  "description": "RHAI ERP API: Express + TypeScript + Prisma (Phase 0/1: auth, sessions, roles, users)",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset:test": "tsx scripts/reset-test-db.ts",
    "inventory:preflight": "tsx scripts/inventory-preflight.ts",
    "job:inventory": "tsx scripts/inventory-daily.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "5.22.0",
    "@rhai/statutory": "file:../../packages/statutory",
    "@types/nodemailer": "6.4.17",
    "@types/qrcode": "1.5.5",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "express-rate-limit": "8.6.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "6.9.16",
    "otpauth": "9.3.6",
    "pdfkit": "^0.20.2",
    "pg-boss": "10.4.2",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "qrcode": "1.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/busboy": "1.5.5",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.17.9",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "6.0.2",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "harfbuzzjs": "1.6.4",
    "prettier": "3.4.1",
    "prisma": "5.22.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.16.0",
    "vitest": "2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
