# Environment variables example (names only - no secrets)
# Copy to .env and provide appropriate values.

NODE_ENV=
PORT=
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_ACCESS_SECRET_PREVIOUS=
JWT_REFRESH_SECRET=
MFA_ENCRYPTION_KEY=
WEB_ORIGINS=
TRUST_PROXY=2

# Mail configuration (optional; email password reset is FEATURE_DISABLED if not configured)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_BASE_URL=

# Rate limit hard ceilings (optional)
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_WINDOW_SEC=
RATE_LIMIT_API_MAX=
RATE_LIMIT_API_WINDOW_SEC=

# Initial bootstrap (only read when database is empty)
SUPERADMIN_LOGIN_ID=
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=
