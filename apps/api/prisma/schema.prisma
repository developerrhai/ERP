/// Phase 6B: versioned document layouts (docs/phases/PHASE-06B.md §4). Foreign keys live in the SQL.
model FormatDefinition {
  id            String    @id @default(uuid()) @db.Uuid
  pageId        String    @map("page_id") @db.VarChar(80)
  kind          String    @db.VarChar(8)
  customerId    String?   @map("customer_id") @db.Uuid
  unitId        String?   @map("unit_id") @db.Uuid
  version       Int
  status        String    @default("DRAFT") @db.VarChar(16)
  name          String    @db.VarChar(120)
  schema        Json
  sourceFileId  String?   @map("source_file_id") @db.Uuid
  reason        String?   @db.VarChar(500)
  rowVersion    Int       @default(1) @map("row_version")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById   String    @map("created_by_id") @db.Uuid
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById   String?   @map("updated_by_id") @db.Uuid
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  publishedById String?   @map("published_by_id") @db.Uuid
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(3)

  @@map("format_definitions")
}

/// Phase 6B: versioned calculation parameters and formulas.
model RuleSet {
  id             String    @id @default(uuid()) @db.Uuid
  pageId         String    @map("page_id") @db.VarChar(80)
  code           String    @db.VarChar(40)
  version        Int
  status         String    @default("DRAFT") @db.VarChar(16)
  name           String    @db.VarChar(120)
  moneyAffecting Boolean   @default(true) @map("money_affecting")
  definition     Json
  sourceFileId   String?   @map("source_file_id") @db.Uuid
  reason         String?   @db.VarChar(500)
  rowVersion     Int       @default(1) @map("row_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String    @map("created_by_id") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  updatedById    String?   @map("updated_by_id") @db.Uuid
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  publishedById  String?   @map("published_by_id") @db.Uuid
  retiredAt      DateTime? @map("retired_at") @db.Timestamptz(3)

  @@unique([pageId, code, version], map: "rule_sets_version_uq")
  @@map("rule_sets")
}

/// Phase 6B: append-only history of settings changes (a trigger blocks UPDATE / DELETE).
model SettingsChange {
  id          String   @id @default(uuid()) @db.Uuid
  targetType  String   @map("target_type") @db.VarChar(10)
  targetId    String   @map("target_id") @db.Uuid
  pageId      String   @map("page_id") @db.VarChar(80)
  version     Int
  action      String   @db.VarChar(12)
  changedById String?  @map("changed_by_id") @db.Uuid
  reason      String?  @db.VarChar(500)
  before      Json?
  after       Json?
  at          DateTime @default(now()) @db.Timestamptz(3)

  @@map("settings_changes")
}

/// Phase 8 / migration E: customer-supplied material (no value, never in stock_balances or the GL).
model CustomerMaterialLot {
  id          String    @id @default(uuid()) @db.Uuid
  unitId      String    @map("unit_id") @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  itemId      String    @map("item_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  batchNo     String?   @map("batch_no") @db.VarChar(60)
  mfgDate     DateTime? @map("mfg_date") @db.Date
  expiryDate  DateTime? @map("expiry_date") @db.Date
  challanNo   String    @map("challan_no") @db.VarChar(60)
  challanDate DateTime  @map("challan_date") @db.Date
  receivedQty Decimal   @map("received_qty") @db.Decimal(18, 3)
  balanceQty  Decimal   @map("balance_qty") @db.Decimal(18, 3)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("customer_material_lots")
}

model CustomerMaterialDoc {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @db.VarChar(40)
  unitId        String    @map("unit_id") @db.Uuid
  fyId          String    @map("fy_id") @db.Uuid
  docType       String    @map("doc_type") @db.VarChar(10)
  docDate       DateTime  @map("doc_date") @db.Date
  customerId    String    @map("customer_id") @db.Uuid
  warehouseId   String    @map("warehouse_id") @db.Uuid
  challanNo     String?   @map("challan_no") @db.VarChar(60)
  challanDate   DateTime? @map("challan_date") @db.Date
  vehicleNo     String?   @map("vehicle_no") @db.VarChar(30)
  reference     String?   @db.VarChar(120)
  remarks       String?   @db.VarChar(300)
  status        String    @default("Posted") @db.VarChar(10)
  cancelReason  String?   @map("cancel_reason") @db.VarChar(300)
  cancelDate    DateTime? @map("cancel_date") @db.Date
  cancelledById String?   @map("cancelled_by_id") @db.Uuid
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(3)
  version       Int       @default(1)
  createdById   String    @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@unique([unitId, code], map: "cmd_unit_code_key")
  @@map("customer_material_docs")
}

model CustomerMaterialLine {
  id      String  @id @default(uuid()) @db.Uuid
  docId   String  @map("doc_id") @db.Uuid
  lineNo  Int     @map("line_no")
  lotId   String  @map("lot_id") @db.Uuid
  itemId  String  @map("item_id") @db.Uuid
  qty     Decimal @db.Decimal(18, 3)
  remarks String? @db.VarChar(200)

  @@unique([docId, lineNo], map: "cmln_doc_line_key")
  @@map("customer_material_lines")
}

model CustomerMaterialLedger {
  id           String   @id @default(uuid()) @db.Uuid
  lotId        String   @map("lot_id") @db.Uuid
  docId        String   @map("doc_id") @db.Uuid
  lineId       String   @map("line_id") @db.Uuid
  entryType    String   @map("entry_type") @db.VarChar(10)
  qty          Decimal  @db.Decimal(18, 3)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(18, 3)
  entryDate    DateTime @map("entry_date") @db.Date
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("customer_material_ledger")
}
