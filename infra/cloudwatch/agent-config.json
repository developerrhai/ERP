{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/home/ec2-user/.pm2/logs/erp-a-out.log",
            "log_group_name": "/sawant-erp/api",
            "log_stream_name": "{instance_id}/erp-a",
            "retention_in_days": 400
          },
          {
            "file_path": "/home/ec2-user/.pm2/logs/erp-b-out.log",
            "log_group_name": "/sawant-erp/api",
            "log_stream_name": "{instance_id}/erp-b",
            "retention_in_days": 400
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "SawantERP/EC2",
    "metrics_collected": {
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/"]
      },
      "mem": {
        "measurement": ["mem_used_percent"]
      }
    }
  }
}

